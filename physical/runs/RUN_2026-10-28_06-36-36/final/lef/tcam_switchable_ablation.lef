      LAYER met3 ;
        RECT 104.280 16.360 104.880 16.960 ;
    END
  END rst
  PIN search_done
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 0.445500 ;
    PORT
      LAYER met3 ;
