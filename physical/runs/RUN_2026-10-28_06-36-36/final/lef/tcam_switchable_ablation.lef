    END
  END search_key[0]
  PIN search_key[1]
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.159000 ;
    PORT
      LAYER met3 ;
        RECT 104.280 77.560 104.880 78.160 ;
    END
  END search_key[1]
  PIN search_key[2]
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.159000 ;
    PORT
      LAYER met2 ;
        RECT 77.370 115.320 77.650 115.600 ;
    END
  END search_key[2]
  PIN search_key[3]
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.159000 ;
