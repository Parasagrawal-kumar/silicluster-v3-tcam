VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO tcam_switchable_ablation
  CLASS BLOCK ;
  FOREIGN tcam_switchable_ablation ;
  ORIGIN 0.000 0.000 ;
  SIZE 104.880 BY 115.600 ;
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met4 ;
        RECT 24.340 10.640 25.940 103.600 ;
    END
    PORT
      LAYER met5 ;
        RECT 5.520 30.030 99.360 31.630 ;
    END
  END VGND
  PIN VPWR
    DIRECTION INOUT ;
